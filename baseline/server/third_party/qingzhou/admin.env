# QingZhou admin 示例配置（.env 风格，key=value，'#' 开头为注释）
#
# 生产部署前务必：
#   1) 配置强随机 secret（`openssl rand -hex 32` 生成）
#   2) 按需改端口 / 数据库路径 / token 有效期

# 监听端口（默认 3000）
port=3000

# CangDB 数据文件路径（默认 admin.cjdb）
db=admin.cjdb

# JWT 签名密钥。生产环境必须配置强随机值，否则每次启动随机、
# 重启后所有已签发 token 立即失效。
# secret=

# token 有效期（秒），默认 7200（2 小时）
ttl=7200

# 运维关闭凭证（deploy-admin.sh stop 会用它登录拿 token）
# 生产环境务必改掉默认值
admin_user=admin
admin_pass=admin123
