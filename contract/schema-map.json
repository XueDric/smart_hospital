{
  "description": "契约样例 → Schema 的映射表，由 server/tests/contract-check.ps1 读取。规则：`file` 里的 Schema 对**每个**样例文件整体生效（钉住样例文件本身的结构）；`map` 里每个样例名对应 {body, data, body_text, error_code} 四样——body 校验 response.body，data 校验 response.body.data，body_text 校验 response.body_text（SSE 等非 JSON 主体，例如 previsit-stream-sse-200），error_code 断言 response.body.error.code 就是这个业务码。⚠ 新增样例必须同时在这里登记：门禁会把「有样例但没登记」当失败（否则新端点可以偷偷绕过契约）。",
  "file": ["artifact"],
  "map": {
    "health-200": { "body": ["health"] },
    "error-invalid-json-400": { "body": ["flat-error"] },
    "error-route-not-found-404": { "body": ["envelope-error"], "error_code": "ROUTE_NOT_FOUND" },
    "error-method-not-allowed-405": { "body": ["method-not-allowed"] },
    "error-static-not-found-404": { "body": ["static-not-found"] },

    "auth-login-200": { "body": ["envelope-ok"], "data": ["data-auth-login"] },
    "auth-login-bad-password-401": { "body": ["envelope-error"], "error_code": "AUTH_BAD_CREDENTIALS" },
    "auth-token-missing-401": { "body": ["envelope-error"], "error_code": "AUTH_REQUIRED" },
    "auth-role-forbidden-403": { "body": ["envelope-error"], "error_code": "FORBIDDEN_ROLE" },

    "booking-create-201": { "body": ["envelope-ok"], "data": ["data-booking-created"] },
