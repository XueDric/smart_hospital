{
  "title": "医生叫号队列 data",
  "description": "应用于 response.body.data。每行都带 `previsit_ready`：**只有绑定到这张挂号单**的预问诊才算 true（否则历史单会全亮徽标，徽标就没意义了）。record_* 是这张单的病历状态摘要，避免队列页为每行再打一次详情请求。本端点**不回显分页字段**（队列是当天的，服务端自己夹取）。",
  "type": "object",
  "required": ["items", "count", "doctor_id"],
  "additionalProperties": false,
  "properties": {
    "count": { "type": "integer", "minimum": 0 },
    "doctor_id": { "type": "integer" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["appointment_id", "patient_id", "doctor_id", "department_id", "visit_date", "period", "seq_no", "status", "previsit_ready", "record_id", "record_status", "record_filled", "record_total"],
        "additionalProperties": false,
        "properties": {
          "appointment_id": { "type": "integer" },
          "patient_id": { "type": "integer" },
          "doctor_id": { "type": "integer" },
          "department_id": { "type": "integer" },
          "visit_date": { "type": "string", "minLength": 6, "description": "日期；样例里归一化成占位符 <date>（6 字符），真实值是 YYYY-MM-DD" },
          "period": { "type": "string", "enum": ["AM", "PM"] },
          "seq_no": { "type": "integer" },
          "status": { "type": "string", "enum": ["booked", "visiting", "finished", "cancelled", "no_show"] },
          "previsit_ready": { "type": "boolean" },
          "record_id": { "type": "integer" },
          "record_status": { "type": "string", "enum": ["none", "draft", "locked"] },
          "record_filled": { "type": "integer", "minimum": 0 },
          "record_total": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
