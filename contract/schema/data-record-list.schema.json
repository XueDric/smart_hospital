{
  "title": "患者病历列表 data（分页：items + count）",
  "description": "应用于 response.body.data。⚠ 列表 item 是**精简形状**：没有 sections / previsit_ref（正文另外单查），但带就诊信息（科室/日期/医生）。本项目列表端点**不回显 limit/offset**（夹取后的值只有管理员用户列表回显），所以这里不要求它们出现 —— 需要分页回显的端点是少数，别按一个模子写客户端。",
  "type": "object",
  "required": ["items", "count"],
  "additionalProperties": false,
  "properties": {
    "count": { "type": "integer", "minimum": 0 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "appointment_id", "patient_id", "doctor_id", "status", "locked", "filled", "total_sections", "complete", "updated_by", "created_at", "updated_at", "missing_required", "department_id", "visit_date", "period", "department_name", "doctor_name", "doctor_title"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "integer" },
          "appointment_id": { "type": "integer" },
          "patient_id": { "type": "integer" },
          "doctor_id": { "type": "integer" },
          "status": { "type": "string", "enum": ["draft", "locked"] },
          "locked": { "type": "boolean" },
          "filled": { "type": "integer", "minimum": 0 },
          "total_sections": { "type": "integer", "minimum": 1 },
          "complete": { "type": "boolean" },
          "updated_by": { "type": "integer" },
          "created_at": { "type": "integer" },
          "updated_at": { "type": "integer" },
          "missing_required": { "type": "array", "items": { "type": "string" } },
          "department_id": { "type": "integer" },
          "visit_date": { "type": "string", "minLength": 6, "description": "日期；样例里归一化成占位符 <date>（6 字符），真实值是 YYYY-MM-DD" },
          "period": { "type": "string", "enum": ["AM", "PM"] },
          "department_name": { "type": "string" },
          "doctor_name": { "type": "string" },
          "doctor_title": { "type": "string" }
        }
      }
    }
  }
}
