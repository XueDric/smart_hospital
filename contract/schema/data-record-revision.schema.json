{
  "title": "病历某一版详情 data（GET /api/v1/doctor/visits/:id/record/revisions/:version）",
  "description": "应用于 response.body.data。sections **与 medicalRecordJson 的 sections 同形状**（key/label/value/max_len）——同一份数据两种形状是两端不一致的高发地，客户端已经写好了渲染七段的那段代码。sections 含**全部七段**（空段也在、value 为空串）：既能看出「当时写了什么」，也能看出「当时没写什么」。取不到的版本一律 404 REVISION_NOT_FOUND（**不是**空对象 —— 空对象会让客户端渲染出「七段全空」的假版本，看起来像病历被清空了）。",
  "type": "object",
  "required": ["version", "status", "operation", "reason", "operator_user_id", "operator_role", "created_at",
               "record_id", "appointment_id", "sections"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "status": { "type": "string", "enum": ["draft", "locked"] },
    "operation": { "type": "string", "enum": ["lock", "reopen"] },
    "reason": { "type": "string" },
    "operator_user_id": { "type": "integer" },
    "operator_role": { "type": "string" },
    "created_at": { "type": "integer" },
    "record_id": { "type": "integer" },
    "appointment_id": { "type": "integer" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "label", "value", "max_len"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "value": { "type": "string" },
          "max_len": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
