{
  "title": "病历 data（医生视角，含 sections 与来源痕迹）",
  "description": "应用于 response.body.data。sections 的**顺序与 label 由服务端给**，客户端不要自己写死七段的中文名（服务端改文案时前端不该跟着发版）。previsit_ref 是**初值来源快照**：它说明「这几段的值最初来自患者的预问诊单」，医生之后改写这些段**不会**改变它 —— 所以角标文案要写「预填来源」，不能写「这段是患者写的」。sections[].max_len 是服务端承认的上限。",
  "type": "object",
  "required": ["id", "appointment_id", "patient_id", "doctor_id", "status", "locked", "filled", "total_sections", "complete", "updated_by", "created_at", "updated_at", "missing_required", "sections", "previsit_ref"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "integer" },
    "appointment_id": { "type": "integer" },
    "patient_id": { "type": "integer" },
    "doctor_id": { "type": "integer" },
    "status": { "type": "string", "enum": ["draft", "locked"] },
    "locked": { "type": "boolean" },
    "filled": { "type": "integer", "minimum": 0 },
    "total_sections": { "type": "integer", "minimum": 1 },
    "complete": { "type": "boolean" },
    "updated_by": { "type": "integer" },
    "revision_version": {
      "type": "integer",
      "minimum": 0,
      "description": "★ 2026-10-15（改进 3）**仅定稿（lock）与解锁（reopen）的响应**带这个字段：本次动作落下的修订版本号。`0` = 审计行没写上（**病历动作已成功**）⇒ 客户端要当成「版本号未知/待补」，不能当失败重试（重试会走幂等路径自愈那一版）。PUT/GET 病历的响应**不含**它。"
    },
    "created_at": { "type": "integer" },
    "updated_at": { "type": "integer" },
    "missing_required": { "type": "array", "items": { "type": "string" } },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "label", "value", "max_len", "required_to_lock"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "value": { "type": "string" },
          "max_len": { "type": "integer", "minimum": 1 },
          "required_to_lock": { "type": "boolean" }
        }
      }
    },
    "previsit_ref": {
      "type": "object",
      "required": ["session_id", "sections", "at"],
      "additionalProperties": false,
      "properties": {
        "session_id": { "type": "string", "minLength": 1 },
        "sections": { "type": "array", "items": { "type": "string" } },
        "at": { "type": "integer" }
      }
    }
  }
}
