{
  "title": "挂号成功 data（新号 / 幂等重放 / 反查）",
  "description": "应用于 response.body.data。`previsit_bound` 表示「患者这次提交的预问诊单是否真的交到了医生手上」——**不要**把「客户端提交了 session_id」当成它。request_id/server_time 用于「响应丢了」时反查（配合 GET /appointments/by-token/:token，见 §5.27）。",
  "type": "object",
  "required": ["appointment_id", "schedule_id", "patient_id", "doctor_id", "department_id", "visit_date", "period", "seq_no", "status", "slot_restored", "department_name", "doctor_name", "doctor_title", "remain_num", "previsit_bound", "request_id", "server_time"],
  "additionalProperties": false,
  "properties": {
    "appointment_id": { "type": "integer" },
    "schedule_id": { "type": "integer" },
    "patient_id": { "type": "integer" },
    "doctor_id": { "type": "integer" },
    "department_id": { "type": "integer" },
    "visit_date": { "type": "string", "minLength": 6 },
    "period": { "type": "string", "enum": ["AM", "PM"] },
    "seq_no": { "type": "integer" },
    "status": { "type": "string", "enum": ["booked"] },
    "slot_restored": { "type": "boolean" },
    "department_name": { "type": "string" },
    "doctor_name": { "type": "string" },
    "doctor_title": { "type": "string" },
    "remain_num": { "type": "integer" },
    "previsit_bound": { "type": "boolean" },
    "request_id": { "type": "string" },
    "server_time": { "type": "integer" }
  }
}
