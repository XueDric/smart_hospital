{
  "name": "auth-role-forbidden-403",
  "group": "auth",
  "request": {
    "method": "GET",
    "path": "/api/v1/doctor/visits",
    "auth": "patient"
  },
  "response": {
    "status": 403,
    "content_type": "application/json; charset=utf-8",
    "body": {
      "ok": false,
      "error": {
        "code": "FORBIDDEN_ROLE",
        "message": "角色 patient 无权执行 manage_visit"
      }
    }
  }
}
