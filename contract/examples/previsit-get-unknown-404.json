{
  "name": "previsit-get-unknown-404",
  "group": "previsit",
  "request": {
    "method": "GET",
    "path": "/api/v1/previsit/no-such-session",
    "auth": "patient"
  },
  "response": {
    "status": 404,
    "content_type": "application/json; charset=utf-8",
    "body": {
      "ok": false,
      "error": {
        "code": "PREVISIT_NOT_FOUND",
        "message": "预问诊会话不存在或已失效"
      }
    }
  }
}
