{
  "name": "error-method-not-allowed-405",
  "group": "envelope",
  "request": {
    "method": "PUT",
    "path": "/health",
    "auth": "none"
  },
  "response": {
    "status": 405,
    "content_type": "application/json; charset=utf-8",
    "body": {
      "ok": false,
      "error": {
        "code": "METHOD_NOT_ALLOWED",
        "message": "Method Not Allowed（允许的方法：GET）"
      }
    },
    "allow": "GET"
  }
}
