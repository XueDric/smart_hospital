{
  "name": "doctor-visit-arrive-200",
  "group": "record",
  "request": {
    "method": "POST",
    "path": "/api/v1/doctor/visits/{id}/arrive",
    "auth": "doctor"
  },
  "response": {
    "status": 200,
    "content_type": "application/json; charset=utf-8",
    "body": {
      "ok": true,
      "data": {
        "appointment_id": 0,
        "status": "arrived",
        "status_label": "已到院",
        "arrived_at": 0,
        "started_at": 0,
        "finished_at": 0,
        "visit_date": "<date>",
        "period": "AM",
        "seq_no": 0,
        "record_status": "none",
        "record_filled": 0
      }
    }
  }
}
